{
  "name": "payday-clock",
  "productName": "薪动",
  "version": "1.0.0",
  "description": "薪动 · 每一秒，都算数。离线薪资时钟、下班倒计时与置顶专注小窗。",
  "main": "desktop/main.cjs",
  "author": "SamsurTee",
  "license": "MIT",
  "homepage": "https://github.com/SamsurTee/payday-clock",
  "repository": { "type": "git", "url": "https://github.com/SamsurTee/payday-clock.git" },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:mac": "electron-builder --mac zip --arm64 --x64 --publish never",
    "dist:win": "electron-builder --win portable --x64 --publish never",
    "dist:win:cross": "electron-builder --win portable --x64 -c.win.signAndEditExecutable=false --publish never"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.samsurtee.paydayclock",
    "productName": "薪动",
    "asar": true,
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["desktop/**", "index.html", "styles.css", "app.js", "calculator.js", "build/icon.png", "LICENSE"],
    "artifactName": "Payday-Clock-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "notarize": false,
      "target": ["zip"]
    },
    "win": { "icon": "build/icon.ico", "target": ["portable"] },
    "portable": { "artifactName": "Payday-Clock-${version}-windows-${arch}-portable.exe" },
    "publish": null
  }
}
